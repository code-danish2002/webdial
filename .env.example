# Port the server listens on (Render/Railway set this automatically)
PORT=3000

# Optional TURN server for strict networks (free tier: https://www.metered.ca/stun-turn)
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Or provide the full ICE server list as JSON (overrides the two options above)
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Seconds-equivalent ring timeout in ms (default 45000)
# RING_TIMEOUT_MS=45000
